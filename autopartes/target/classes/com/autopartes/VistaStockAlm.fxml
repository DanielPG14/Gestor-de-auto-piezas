<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.StockAlmC">
   
   <top>
      <VBox spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff;">
               <children>
                  <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/logo_autopartes.png" />
                     </image>
                  </ImageView>
                  <Label text="GESTIÓN DE INVENTARIO &amp; ABASTECIMIENTO" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Button onAction="#irAReportes" text="📊 Reporte Ventas" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                  <Button onAction="#irACatalogo" text="Catálogo Venta" />
                  
                  <Separator orientation="VERTICAL" prefHeight="20.0" />
                  <Button onAction="#cerrarSesion" text="Cerrar Sesión" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />
               </children>
               <padding>
                  <Insets top="15.0" right="30.0" bottom="15.0" left="30.0" />
               </padding>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>

   <center>
      <SplitPane dividerPositions="0.2, 0.75" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
          
          <VBox spacing="10.0" style="-fx-background-color: #f8f9fa;">
               <padding>
                  <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
               </padding>
               <children>
                  <Label text="Ubicaciones:" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                  <ComboBox fx:id="cmbZonas" maxWidth="1.7976931348623157E308" promptText="Todas las Zonas" />
                  <Separator />
                  <Label text="Estantes en BD:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <ListView fx:id="listaEstantes" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
          
          <VBox spacing="15.0">
               <padding>
                  <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <TextField fx:id="txtBuscarGeneral" prefWidth="350.0" promptText="Buscar por nombre o ID..." />
                        <Button onAction="#filtrarStock" text="Limpiar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblContador" text="Total: 0 piezas" style="-fx-font-style: italic;" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tablaStock" VBox.vgrow="ALWAYS" styleClass="tabla-moderna">
                    <columns>
                      <TableColumn fx:id="colID" prefWidth="60.0" text="ID" />
                      <TableColumn fx:id="colNombre" prefWidth="200.0" text="Autoparte" />
                      <TableColumn fx:id="colEstante" prefWidth="90.0" text="Estante" />
                      <TableColumn fx:id="colNivel" prefWidth="80.0" text="Nivel" />
                      <TableColumn fx:id="colStock" prefWidth="100.0" text="Existencia" />
                      <TableColumn fx:id="colCapMax" prefWidth="100.0" text="Cap. Máx" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnAnterior" onAction="#paginaAnterior" text="◀" />
                        <Label fx:id="lblPaginaActual" text="Página 1" />
                        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" text="▶" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-min-width: 280;">
               <padding>
                  <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
               </padding>
               <children>
                  <Label text="DETALLES DE PIEZA" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                  <Separator />
                  
                  <VBox spacing="5.0">
                     <Label text="Nombre del Producto:" />
                     <TextField fx:id="txtNombre" />
                  </VBox>

                  <VBox spacing="5.0">
                     <Label text="Proveedor:" />
                     <ComboBox fx:id="cmbProveedores" maxWidth="1.7976931348623157E308" />
                  </VBox>
                  
                  <HBox spacing="10.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <Label text="Estante:" />
                           <TextField fx:id="txtEstante" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                           <Label text="Nivel/Piso:" />
                           <TextField fx:id="txtNivel" />
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="10.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <Label text="Stock Inicial:" />
                           <TextField fx:id="txtStock" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                           <Label text="Cap. Máxima:" />
                           <TextField fx:id="txtCapMax" />
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="5.0">
                     <Label text="Precio Compra ($):" />
                     <TextField fx:id="txtPrecio" />
                  </VBox>

                  <VBox spacing="5.0">
                     <Label text="Código Proveedor:" />
                     <TextField fx:id="txtCodigoProv" />
                  </VBox>

                  <Region VBox.vgrow="ALWAYS" />
                  
                  <VBox spacing="10.0">
                     <Button maxWidth="1.7976931348623157E308" onAction="#agregarPieza" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="📦 Registrar Nueva" prefHeight="40.0" />
                     <Button maxWidth="1.7976931348623157E308" onAction="#actualizarPieza" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="🔄 Actualizar Stock" prefHeight="40.0" />
                     <Button maxWidth="1.7976931348623157E308" onAction="#limpiarFormulario" text="Limpiar Campos" />
                  </VBox>
               </children>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>