<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.CarritoVentaC">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="CARRITO DE COMPRAS" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#volverCatalogo" text="Regresar" />
            </children>
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Productos Seleccionados" />
                <TableView fx:id="tableViewCarrito" prefHeight="430.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="260.0" text="Producto" />
                        <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
                        <TableColumn fx:id="colPrecioVenta" prefWidth="140.0" text="Precio unitario" />
                        <TableColumn fx:id="colIvaPct" prefWidth="100.0" text="IVA %" />
                        <TableColumn fx:id="colTotalLinea" prefWidth="140.0" text="Total línea" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
            <padding>
                <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
            </padding>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="320.0" spacing="14.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Agregar producto" />
                <Label text="Producto seleccionado:" />
                <Label fx:id="lblProductoSeleccionado" style="-fx-font-weight: bold;" text="Ninguno" wrapText="true" />
                <HBox spacing="10.0">
                    <children>
                        <Label text="Cantidad:" />
                        <TextField fx:id="txtCantidad" promptText="1" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Utilidad %:" />
                        <TextField fx:id="txtUtilidadPct" promptText="15" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="IVA %:" />
                        <TextField fx:id="txtIvaPct" promptText="16" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                
                <Button fx:id="btnAgregarItem" maxWidth="1.7976931348623157E308" onAction="#agregarItemAlCarrito" text="Agregar ítem" />
                <Button fx:id="btnEliminarItem" maxWidth="1.7976931348623157E308" onAction="#eliminarItemSeleccionado" text="Eliminar ítem" />
                <Separator />
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Resumen de la orden" />
                <HBox>
                    <children>
                        <Label text="Subtotal:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" text="\$0.00" />
                    </children>
                </HBox>
                <HBox>
                    <children>
                        <Label text="IVA:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblIvaGeneral" text="\$0.00" />
                    </children>
                </HBox>
                <HBox>
                    <children>
                        <Label text="TOTAL:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="\$0.00" />
                    </children>
                </HBox>
                <Label text="Método de pago:" />
                <ComboBox fx:id="comboMetodoPago" maxWidth="1.7976931348623157E308" promptText="Seleccionar método" />
                <Button fx:id="btnProcederCheckout" maxWidth="1.7976931348623157E308" onAction="#irACheckout" text="Procesar Venta" />
                <Button fx:id="btnVerReporte" maxWidth="1.7976931348623157E308" onAction="#irAReporte" text="Ver Reporte de Ventas" />
                <Button fx:id="btnVaciarCarrito" maxWidth="1.7976931348623157E308" onAction="#vaciarCarrito" text="Vaciar Carrito" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>