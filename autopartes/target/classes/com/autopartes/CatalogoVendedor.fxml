<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.CatalogoC">
    <top>
        <VBox spacing="10.0">
            <children>
                <HBox alignment="CENTER" prefHeight="90.0" spacing="20.0">
                    <children>
                        <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo_autopartes.png" />
                            </image>
                        </ImageView>
                        <MenuButton prefHeight="45.0" styleClass="menu-hamburguesa" text="☰">
                            <items>
                                <MenuItem onAction="#irACatalogo" text="Catálogo" />
                                <MenuItem onAction="#irAMapaAlmacen" text="Mapa de Almacén" />
                                <MenuItem onAction="#irACarrito" text="Carrito de Compras" />
                                <MenuItem fx:id="menuReporte" onAction="#irAReporte" text="Reporte de Ventas" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#cerrarSesion" text="Cerrar Sesión" />
                            </items>
                        </MenuButton>
                        <TextField fx:id="txtBuscarGeneral" prefHeight="45.0" promptText="Buscar autopartes por nombre, proveedor o código..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#filtrarCatalogo" prefHeight="45.0" prefWidth="120.0" text="Buscar" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="40.0" right="40.0" top="10.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnReporte" onAction="#irAReporte" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Ver Reporte" />
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="40.0" right="40.0" top="0.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tablaPiezas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdPieza" prefWidth="80.0" text="ID Pieza" />
                        <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre Autoparte" />
                        <TableColumn fx:id="colProveedor" prefWidth="220.0" text="Proveedor" />
                        <TableColumn fx:id="colCodigoProveedor" prefWidth="150.0" text="Cód. Proveedor" />
                        <TableColumn fx:id="colPrecioCompra" prefWidth="120.0" text="Precio Costo ($)" />
                        <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock Disponible" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </children>
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="15.0">
            <children>
                <Button fx:id="btnAgregarCarrito" mnemonicParsing="false" onAction="#agregarAlCarrito" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25;" text="Agregar al Carrito 🛒" />
            </children>
            <padding>
                <Insets bottom="20.0" right="40.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>