<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="titulo-principal" text="REPORTE DE VENTAS" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Button text="🏠 Regresar al Menú" />
                  
               </children>
            </HBox>
         </children>
         <padding><Insets bottom="20.0" left="30.0" right="30.0" top="20.0" /></padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Desde:" /><DatePicker />
                  <Label text="Hasta:" /><DatePicker />
                  
                  <Button text="🔍 Filtrar" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="📄 Exportar a PDF" />
                  
               </children>
            </HBox>
            <TableView VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn prefWidth="100.0" text="Folio / ID" />
                <TableColumn prefWidth="150.0" text="Fecha" />
                <TableColumn prefWidth="250.0" text="Producto" />
                <TableColumn prefWidth="100.0" text="Cantidad" />
                <TableColumn prefWidth="120.0" text="Total Venta" />
              </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label styleClass="subtitulo" text="TOTAL ACUMULADO:" />
                  <Label styleClass="subtitulo" text="\$ 0.00" />
               </children>
               <padding><Insets bottom="10.0" top="10.0" /></padding>
            </HBox>
         </children>
         <padding><Insets left="30.0" right="30.0" /></padding>
      </VBox>
   </center>
</BorderPane>