<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.CarritoC">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="CARRITO DE COMPRAS" />
            <Region HBox.hgrow="ALWAYS" />
            
            <Button onAction="#volverCatalogo" text="Regresar" />
            
         </children>
         <padding><Insets bottom="20.0" left="30.0" right="30.0" top="20.0" /></padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Productos Seleccionados" />
            <TableView VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn prefWidth="250.0" text="Producto" />
                <TableColumn prefWidth="120.0" text="Id_Producto" />
                <TableColumn prefWidth="100.0" text="Cantidad" />
                <TableColumn prefWidth="120.0" text="Subtotal" />
                <TableColumn prefWidth="120.0" text="Total" />
              </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
         </children>
         <padding><Insets bottom="30.0" left="30.0" right="15.0" /></padding>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="300.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="RESUMEN DE LA ORDEN" />
            <Separator />
            <HBox>
               <children>
                  <Label text="Subtotal:" /><Region HBox.hgrow="ALWAYS" /><Label text="0.00" />
               </children>
            </HBox>
            <HBox>
               <children>
                  <Label text="IVA (16%):" /><Region HBox.hgrow="ALWAYS" /><Label text="0.00" />
               </children>
            </HBox>
            <Separator />
            <HBox>
               <children>
                  <Label text="TOTAL:" /><Region HBox.hgrow="ALWAYS" /><Label text="0.00" />
               </children>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="5.0">
               <children>
                  <Label text="Método de Pago:" />
                  <ComboBox fx:id="comboMetodoPago" maxWidth="1.7976931348623157E308" promptText="Seleccionar..." />
               </children>
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </VBox>
            
            <Button maxWidth="1.7976931348623157E308" onAction="#irACheckout" text="Generar Ticket / Pagar" />
            
            <Button maxWidth="1.7976931348623157E308" text="Vaciar Carrito" />
         </children>
         <padding><Insets bottom="30.0" left="15.0" right="30.0" /></padding>
      </VBox>
   </right>
</BorderPane>