<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.CheckoutC">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                    <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo_autopartes.png" />
                        </image>
                    </ImageView>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="CHECKOUT / REVISIÓN DE VENTA" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnVolverCarrito" onAction="#volverCarrito" text="🔙 Volver al Carrito" />
            </children>
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <HBox spacing="30.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
            </padding>
            <children>
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Artículos de la Orden" />
                        <TableView fx:id="tablaCheckout" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Producto" />
                                <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cant." />
                                <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Unit." />
                                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total Línea" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox prefWidth="320.0" spacing="20.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Resumen de Venta" />
                        <Separator />
                        <VBox spacing="15.0">
                            <children>
                                <HBox>
                                    <children>
                                        <Label text="Subtotal:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblSubtotalVenta" text="0.00" />
                                    </children>
                                </HBox>
                                <HBox>
                                    <children>
                                        <Label text="IVA:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblIvaVenta" text="0.00" />
                                    </children>
                                </HBox>
                                <HBox>
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="TOTAL:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblTotalVenta" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="0.00" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <Separator />
                        <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="Al confirmar, se registrará la transacción en las tablas 'ticket' y 'lista_ticket'." wrapText="true" />
                        <Button fx:id="btnConfirmarVenta" maxWidth="1.7976931348623157E308" onAction="#confirmarVenta" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px;" text="✔ Confirmar y Generar Ticket" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>