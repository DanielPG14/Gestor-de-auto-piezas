<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.StockC">

   <top>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="VISTA STOCK / CONSULTA DE INVENTARIO (CAJERO)" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Buscador general:" />
                  <TextField fx:id="txtBuscarGeneral" prefWidth="300.0" promptText="Buscar por nombre, ID o estante..." />
                  <Button onAction="#filtrarStock" text="Filtrar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </top>

   <center>
      <VBox BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" />
         </padding>
         <children>
            <TableView fx:id="tablaStock" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colID" prefWidth="80.0" text="ID Pieza" />
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre de la Pieza" />
                <TableColumn fx:id="colEstante" prefWidth="120.0" text="ID Estante" />
                <TableColumn fx:id="colNivel" prefWidth="120.0" text="Nivel / Piso" />
                <TableColumn fx:id="colStock" prefWidth="120.0" text="Stock Actual" />
                <TableColumn fx:id="colCapMax" prefWidth="120.0" text="Cap. Máxima" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>