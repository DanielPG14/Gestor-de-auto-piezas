<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1150.0" stylesheets="@css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.autopartes.Controlador.StockC">
   
   <top>
      <VBox spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="SISTEMA DE EXISTENCIAS &amp; UBICACIONES" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Button onAction="#irACatalogo" text="Catálogo Venta" />
                  <Button onAction="#irACarrito" text="Carrito 🛒" />
                  <Button onAction="#irAReporte" text="Reporte Ventas 📊" />                  
                  <Separator orientation="VERTICAL" prefHeight="20.0" />
                  <Button onAction="#cerrarSesion" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Cerrar Sesión" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="30.0" right="30.0" top="15.0" />
               </padding>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>

   <center>
      <SplitPane dividerPositions="0.25" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
          
          <VBox spacing="10.0" style="-fx-background-color: #f8f9fa;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Filtro por Zona/Pasillo:" />
                  <ComboBox fx:id="cmbZonas" maxWidth="1.7976931348623157E308" promptText="Todos los Pasillos" />
                  <Separator />
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Estantes Disponibles:" />
                  
                  <ListView fx:id="listaEstantes" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
          
          <VBox spacing="15.0">
               <padding>
                  <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Buscador en tiempo real:" />
                        <TextField fx:id="txtBuscarGeneral" prefWidth="350.0" promptText="Ingresa nombre, ID o código alterno..." />
                        <Button onAction="#filtrarStock" text="Limpiar Filtro" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblContador" style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;" text="Mostrando: 0 artículos" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tablaStock" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colID" prefWidth="85.0" text="ID Pieza" />
                      <TableColumn fx:id="colNombre" prefWidth="280.0" text="Descripción / Autoparte" />
                      <TableColumn fx:id="colEstante" prefWidth="110.0" text="Estante Asig." />
                      <TableColumn fx:id="colNivel" prefWidth="110.0" text="Nivel / Piso" />
                      <TableColumn fx:id="colStock" prefWidth="120.0" text="Existencias" />
                      <TableColumn fx:id="colCapMax" prefWidth="120.0" text="Cap. Máxima" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="btnAnterior" onAction="#paginaAnterior" text="◀ Anterior" />
                        <Label fx:id="lblPaginaActual" style="-fx-font-weight: bold;" text="Página 1 de 1" />
                        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" text="Siguiente ▶" />
                     </children>
                  </HBox>
               </children>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>